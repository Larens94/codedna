#!/usr/bin/env bash
# CodeDNA v0.8 pre-commit hook — validates staged files.
#
# Installation (recommended):
#   codedna install
#
# Manual installation:
#   cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

CODEDNA=""
for cmd in codedna; do
    if command -v "$cmd" &>/dev/null; then
        CODEDNA="$cmd"
        break
    fi
done

if [[ -z "$CODEDNA" ]]; then
    echo "WARNING: codedna CLI not found in PATH — skipping validation"
    echo "         pip install git+https://github.com/Larens94/codedna.git"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Collect staged source files (new, modified, copied)
STAGED=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.(py|ts|tsx|js|jsx|mjs|go|php|rs|java|kt|kts|rb|cs|swift|blade\.php|j2|jinja2|twig|erb|ejs|hbs|mustache|cshtml|razor|vue|svelte)$' \
    | grep -v '^tests/fixtures/' \
    || true)

if [[ -z "$STAGED" ]]; then
    exit 0
fi

echo "CodeDNA v0.8 — validating staged files..."

# Auto-refresh exports: and used_by: via AST (zero LLM cost)
PY_STAGED=$(echo "$STAGED" | grep '\.py$' || true)
if [[ -n "$PY_STAGED" ]]; then
    "$CODEDNA" refresh "$REPO_ROOT" --exclude "venv/*" ".venv/*" "node_modules/*" 2>/dev/null || true
    # Re-stage any staged file that refresh may have rewritten. refresh updates
    # BOTH Python and non-Python headers, so re-stage every staged source file
    # (not just .py) to avoid committing a stale header for a .php/.ts/.js file.
    for FILE in $STAGED; do
        FULL="$REPO_ROOT/$FILE"
        [[ -f "$FULL" ]] && git add "$FULL" 2>/dev/null || true
    done
fi

# Detect extensions in use
EXTS=""
for f in $STAGED; do
    # Handle compound extensions (e.g. .blade.php)
    if [[ "$f" == *.blade.php ]]; then
        EXTS="$EXTS blade.php"
        continue
    fi
    ext="${f##*.}"
    case "$ext" in
        # Pass each extension through as-is — `codedna check` matches the file's
        # real extension. Collapsing js/jsx/mjs → ts made `check file.js
        # --extensions ts` count 0 files (extension mismatch) and the old grep
        # on "L1 (module headers) 0/" then mis-read that as a missing header,
        # blocking every .js/.jsx commit.
        ts|tsx|js|jsx|mjs|cjs) EXTS="$EXTS $ext" ;;
        go)                EXTS="$EXTS go" ;;
        rs)                EXTS="$EXTS rs" ;;
        java)              EXTS="$EXTS java" ;;
        kt|kts)            EXTS="$EXTS kt" ;;
        rb)                EXTS="$EXTS rb" ;;
        cs)                EXTS="$EXTS cs" ;;
        swift)             EXTS="$EXTS swift" ;;
        j2|jinja2)         EXTS="$EXTS j2" ;;
        twig)              EXTS="$EXTS twig" ;;
        erb)               EXTS="$EXTS erb" ;;
        ejs)               EXTS="$EXTS ejs" ;;
        hbs|mustache)      EXTS="$EXTS hbs" ;;
        cshtml|razor)      EXTS="$EXTS cshtml" ;;
        vue)               EXTS="$EXTS vue" ;;
        svelte)            EXTS="$EXTS svelte" ;;
    esac
done
# Deduplicate
EXTS=$(echo "$EXTS" | tr ' ' '\n' | sort -u | tr '\n' ' ')

# Build codedna check args
ARGS="--verbose"
if [[ -n "$EXTS" ]]; then
    ARGS="$ARGS --extensions $EXTS"
fi

# Validate each staged file individually
ERRORS=0
for FILE in $STAGED; do
    FULL="$REPO_ROOT/$FILE"
    [[ -f "$FULL" ]] || continue

    OUTPUT=$("$CODEDNA" check "$FULL" $ARGS 2>&1) || true

    # Block only on a MISSING L1 module header. The "Missing L1:" (Python) and
    # "Missing non-Python L1:" markers only appear (with --verbose) when a file
    # genuinely lacks a header — they list the offending files. This is robust
    # across Python vs non-Python: the "L1 (module headers) X/Y" summary counts
    # Python files ONLY, so it is always 0/0 for a .js/.php file and must NOT be
    # used as the block signal.
    if echo "$OUTPUT" | grep -qE "^Missing (non-Python )?L1:"; then
        ERRORS=$((ERRORS + 1))
        echo ""
        echo "FAIL  $FILE"
        echo "      Missing CodeDNA module header"
    fi
done

echo ""
if [[ $ERRORS -gt 0 ]]; then
    echo "Commit blocked: $ERRORS file(s) missing CodeDNA v0.8 annotations."
    echo ""
    echo "Quick fix:  codedna init <path> --no-llm    (structural only, instant)"
    echo "Full fix:   codedna init <path>              (with AI-generated rules:)"
    echo "Skip once:  git commit --no-verify"
    exit 1
fi

echo "All staged files pass CodeDNA v0.8 validation."
exit 0
