{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Larens94/codedna/challenge/metrics.schema.json",
  "title": "CodeDNA Challenge metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entrant",
    "mode",
    "stack",
    "project",
    "install",
    "tasks",
    "summary",
    "bugs_reported"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "entrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_handle"
      ],
      "properties": {
        "github_handle": {
          "type": "string",
          "minLength": 1
        },
        "entry_issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "parity",
        "codedna_only"
      ]
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l0_codedna",
        "l1",
        "l2"
      ],
      "properties": {
        "l0_codedna": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "codedna"
          ],
          "properties": {
            "control": {
              "type": "boolean"
            },
            "codedna": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "l1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "present_in_control",
            "present_in_codedna"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "present_in_control": {
              "type": "boolean"
            },
            "present_in_codedna": {
              "type": "boolean"
            }
          }
        },
        "l2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "present_in_control",
            "present_in_codedna"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "present_in_control": {
              "type": "boolean"
            },
            "present_in_codedna": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "frameworks",
        "approx_source_files",
        "size_band",
        "visibility"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "approx_source_files": {
          "type": "integer",
          "minimum": 25,
          "description": "Approximate number of source files. Minimum 25. Toy landing pages / hello-world demos are rejected; must be a real working project (small is OK)."
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Frameworks / major libs (e.g. Django, NestJS, Laravel, Spring)."
        },
        "size_band": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ],
          "description": "S=<50 files, M=50-199, L=200-999, XL=1000+"
        },
        "tech_stack_notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional free-text stack notes (DB, infra, monorepo layout, etc.)."
        }
      }
    },
    "success_definition": {
      "type": "string",
      "description": "How pass/fail was decided for tasks."
    },
    "tasks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "difficulty",
          "control",
          "codedna"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "description": {
            "type": "string"
          },
          "control": {
            "$ref": "#/$defs/condition_result"
          },
          "codedna": {
            "$ref": "#/$defs/condition_result"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks_total",
        "control_passed",
        "codedna_passed",
        "favors"
      ],
      "properties": {
        "tasks_total": {
          "type": "integer",
          "minimum": 10
        },
        "easy_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "hard_count": {
          "type": "integer",
          "minimum": 0
        },
        "control_passed": {
          "type": "integer",
          "minimum": 0
        },
        "codedna_passed": {
          "type": "integer",
          "minimum": 0
        },
        "control_total_minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "codedna_total_minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "control_total_turns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "codedna_total_turns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "favors": {
          "type": "string",
          "enum": [
            "codedna",
            "control",
            "tie",
            "inconclusive"
          ]
        },
        "one_line_verdict": {
          "type": "string"
        }
      }
    },
    "bugs_reported": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Bugs found in CodeDNA during the challenge. Empty array if none. If you hit agent/language issues you MUST file issues or fix PRs and list them here."
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "steps"
      ],
      "description": "How CodeDNA was installed for this run (required \u2014 publish your install path).",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "AI coding agent used (e.g. cursor, claude-code, opencode, codex)."
        },
        "tools_flag": {
          "type": [
            "string",
            "null"
          ],
          "description": "Value passed to `codedna install --tools`, if any."
        },
        "steps": {
          "type": "string",
          "minLength": 1,
          "description": "Exact install/init commands and steps you ran."
        },
        "worked": {
          "type": "boolean",
          "description": "Whether install + annotation completed successfully on this agent/stack."
        },
        "notes": {
          "type": "string",
          "description": "Problems, workarounds, agent-specific gaps."
        }
      }
    }
  },
  "$defs": {
    "condition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "turns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wrong_file_or_module": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "human_interventions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence_1_to_5": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
